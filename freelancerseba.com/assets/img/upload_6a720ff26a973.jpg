<style>
.error-container {
    min-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    position: relative;
    overflow: hidden;
}

/* Floating animated background blobs for cosmic ambiance */
.blob-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    z-index: 0;
    animation: floatBlob 10s ease-in-out infinite alternate;
}
.blob-1 {
    width: 350px;
    height: 350px;
    background: #6E57E0;
    top: 5%;
    left: 10%;
}
.blob-2 {
    width: 300px;
    height: 300px;
    background: #FF5E7E;
    bottom: 10%;
    right: 15%;
    animation-delay: -4s;
}
.blob-3 {
    width: 250px;
    height: 250px;
    background: #00DBDE;
    top: 40%;
    right: 35%;
    animation-delay: -7s;
}

@keyframes floatBlob {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -40px) scale(1.1); }
    100% { transform: translate(-20px, 20px) scale(0.95); }
}

.error-card {
    position: relative;
    z-index: 1;
    background: var(--container-color, #FFFFFF);
    border: 1px solid rgba(110, 87, 224, 0.25);
    border-radius: 28px;
    padding: 50px 40px;
    max-width: 680px;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUpFade {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
}

.error-number {
    font-size: 8.5rem;
    font-weight: 800;
    line-height: 1;
    margin: 0;
    letter-spacing: -4px;
    background: linear-gradient(135deg, var(--first-color) 0%, #B845FF 50%, #FF5E7E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 10px 20px rgba(110, 87, 224, 0.2));
}

.error-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--title-color);
    margin: 10px 0 15px;
    letter-spacing: -0.5px;
}

.error-desc {
    color: var(--text-color);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto 35px;
}

.error-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 35px;
}

.btn-primary-glow {
    background-color: var(--first-color);
    color: #fff;
    padding: 14px 30px;
    border-radius: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px rgba(110, 87, 224, 0.35);
}
.btn-primary-glow:hover {
    background-color: var(--first-color-alt);
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(110, 87, 224, 0.5);
}

.btn-secondary-outline {
    background: var(--container-color);
    color: var(--first-color);
    border: 2px solid var(--first-color);
    padding: 12px 26px;
    border-radius: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
}
.btn-secondary-outline:hover {
    background: var(--first-color-lighter);
    transform: translateY(-3px);
}

/* Quick destination chips */
.error-chips {
    border-top: 1px solid rgba(110, 87, 224, 0.15);
    padding-top: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--text-color-light);
}
.chip-link {
    background: rgba(110, 87, 224, 0.08);
    color: var(--first-color);
    padding: 6px 14px;
    border-radius: 20px;
    text-decoration: none;
    font-weight: 500;
    transition: 0.2s;
}
.chip-link:hover {
    background: var(--first-color);
    color: #fff;
}

@media screen and (max-width: 568px) {
    .error-number { font-size: 6rem; }
    .error-title { font-size: 1.5rem; }
    .error-card { padding: 35px 20px; }
}
</style>

<div class="error-container">
    <!-- Cosmic Background Blobs -->
    <div class="blob-shape blob-1"></div>
    <div class="blob-shape blob-2"></div>
    <div class="blob-shape blob-3"></div>

    <!-- Glassmorphic Error Modal Card -->
    <div class="error-card">
        <div style="font-size: 3.5rem; color: var(--first-color); margin-bottom: 10px; animation: bounce 2s infinite;">
            <i class="uil uil-compass"></i>
        </div>
        
        <h1 class="error-number">404</h1>
        <h2 class="error-title">Oops! You've Drifted Out of Orbit</h2>
        <p class="error-desc">
            The page you are looking for appears to have vanished into deep space, moved to a different coordinate, or never existed in this timeline.
        </p>

        <div class="error-actions">
            <a href="index.php" class="btn-primary-glow">
                <i class="uil uil-estate"></i> Return to Homepage
            </a>
            <a href="javascript:history.back()" class="btn-secondary-outline">
                <i class="uil uil-arrow-left"></i> Go Back
            </a>
        </div>

        <div class="error-chips">
            <span>Quick Destinations:</span>
            <a href="index.php#portfolio" class="chip-link">Showcase Projects</a>
            <a href="index.php#services" class="chip-link">My Services</a>
            <a href="index.php#blog" class="chip-link">Latest Blogs</a>
            <a href="index.php#contact" class="chip-link">Contact Support</a>
        </div>
    </div>
</div>

<script>
// Smooth hover interactive effects for 404 page icons
document.addEventListener("DOMContentLoaded", function() {
    const card = document.querySelector(".error-card");
    if (window.innerWidth > 768 && card) {
        document.addEventListener("mousemove", function(e) {
            let xAxis = (window.innerWidth / 2 - e.pageX) / 45;
            let yAxis = (window.innerHeight / 2 - e.pageY) / 45;
            card.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
        });
        document.addEventListener("mouseleave", function() {
            card.style.transform = "rotateY(0deg) rotateX(0deg)";
        });
    }
});
</script>

