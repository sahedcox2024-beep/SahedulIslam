    <!--==================== REAL-TIME INTERACTION SCRIPTS ====================-->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('fabMainBtn');
            const list = document.getElementById('fabOptionsList');
            if (btn && list) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    btn.classList.toggle('active');
                    list.classList.toggle('show');
                    if (btn.classList.contains('active')) {
                        btn.innerHTML = '<i class="uil uil-times"></i>';
                    } else {
                        btn.innerHTML = '<i class="uil uil-comment-dots"></i>';
                    }
                });
                document.addEventListener('click', function(e) {
                    if (!e.target.closest('.floating-action-stack')) {
                        btn.classList.remove('active');
                        list.classList.remove('show');
                        btn.innerHTML = '<i class="uil uil-comment-dots"></i>';
                    }
                });
            }

            // Auto hide floating message button when mobile nav menu opens
            const navMenuEl = document.getElementById('nav-menu');
            const fabStack = document.querySelector('.floating-action-stack');
            if (navMenuEl && fabStack) {
                const menuObserver = new MutationObserver(() => {
                    if (navMenuEl.classList.contains('show-menu')) {
                        fabStack.style.setProperty('display', 'none', 'important');
                    } else {
                        fabStack.style.removeProperty('display');
                    }
                });
                menuObserver.observe(navMenuEl, { attributes: true, attributeFilter: ['class'] });
            }

            // Initialize Swiper for Blog Section (if exists on page)
            if (document.querySelector('.blog__swiper')) {
                new Swiper('.blog__swiper', {
                    loop: true,
                    spaceBetween: 24,
                    grabCursor: true,
                    autoplay: { delay: 4500, disableOnInteraction: false },
                    pagination: { el: '.swiper-pagination-blog', clickable: true },
                    navigation: { nextEl: '.swiper-button-next-blog', prevEl: '.swiper-button-prev-blog' },
                    breakpoints: { 320: { slidesPerView: 1 }, 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } }
                });
            }
        });
    </script>
</body>
