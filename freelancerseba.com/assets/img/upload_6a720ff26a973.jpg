    <style>
    .splash-preloader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: var(--body-color, #0e0e1a);
        z-index: 999999;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s;
    }
    .splash-preloader.fade-out {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
    .splash-content {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    .splash-ring {
        width: 85px;
        height: 85px;
        border: 4px solid rgba(110, 87, 224, 0.15);
        border-top-color: var(--first-color, #6E57E0);
        border-right-color: #FF5E7E;
        border-bottom-color: #00DBDE;
        border-radius: 50%;
        animation: splash-spin 1.1s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
        margin-bottom: 22px;
        box-shadow: 0 0 25px rgba(110, 87, 224, 0.35);
    }
    @keyframes splash-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .splash-logo {
        font-size: 2.4rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--first-color, #6E57E0), #FF5E7E, #00DBDE);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 2px;
        animation: splash-pulse 1.4s ease-in-out infinite alternate;
    }
    @keyframes splash-pulse {
        0% { transform: scale(0.96); opacity: 0.85; }
        100% { transform: scale(1.05); opacity: 1; filter: drop-shadow(0 0 12px rgba(110,87,224,0.5)); }
    }
    .splash-tagline {
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--text-color-light, #888);
        letter-spacing: 6px;
        margin-top: 6px;
        text-transform: uppercase;
    }
    </style>
    <script>
    window.addEventListener('load', function() {
        setTimeout(function() {
            const pre = document.getElementById('splash-preloader');
            if (pre) pre.classList.add('fade-out');
        }, 500);
    });
    // Fallback safety timeout so visitors are never stuck if an external resource delays load
    setTimeout(function() {
        const pre = document.getElementById('splash-preloader');
        if (pre) pre.classList.add('fade-out');
    }, 2800);
    </script>

